{
  "version": 1,
  "pads": [
    {
      "id": "terminal",
      "name": "Terminal",
      "icon": "terminal-symbolic",
      "class": "noctalia-sidepad-terminal",
      "command": ["kitty", "--class", "noctalia-sidepad-terminal"]
    },
    {
      "id": "browser",
      "name": "Browser",
      "class": "noctalia-sidepad-browser",
      "command": ["firefox", "--no-remote", "--profile", "/ABSOLUTE/PATH/TO/sidepad-data/firefox", "--name", "noctalia-sidepad-browser", "--class", "noctalia-sidepad-browser"]
    },
    {
      "id": "code",
      "name": "VS Code",
      "class": "noctalia-sidepad-code",
      "command": ["code", "--new-window", "--user-data-dir", "/ABSOLUTE/PATH/TO/sidepad-data/code", "--class", "noctalia-sidepad-code", "--ozone-platform=wayland"]
    }
  ]
}
